ANTHROPIC_API_KEY=
# Directory of the project to be analyzed/fixed, mounted at /workspace
WORKSPACE_PATH=./workspace
# Test sandbox: the container that runs the tests (optional; defaults shown).
# SANDBOX_DISK is the space for the copies, in memory; keep it above MAX_SANDBOX_BYTES.
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# SANDBOX_DISK=2g
# Test runner (optional; defaults shown)
# TEST_COMMAND=python -m pytest
# ALLOWED_TEST_COMMANDS=["pytest", "python -m pytest"]
# TEST_TIMEOUT_SECONDS=300
# Patch limits (optional; defaults shown)
# MAX_PATCH_FILES=5
# MAX_PATCH_BYTES=100000
# MAX_PATCH_CHANGED_LINES=300
# Claude (optional; defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=high
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_TIMEOUT_SECONDS=120
# ANTHROPIC_MAX_RETRIES=2
# CONTEXT_MAX_CHARS=12000
# CONTEXT_MAX_DISTANCE=0.7
# Self-correction loop (optional; defaults shown)
# REPAIR_MAX_ATTEMPTS=3
# REPAIR_MAX_TOKENS=100000
# Team sharing (Phase 5, optional). Off by default; every node of the team uses the same key.
# SHARE_SOLUTIONS turns sending on; `healer listen` only needs SHARE_KEY and NODE_ID.
# Generate a key with: python3 -c "import secrets; print(secrets.token_hex(32))"
# SHARE_SOLUTIONS=false
# SHARE_KEY=
# NODE_ID must be fixed and unique per machine: the broker keeps what this node missed under it.
# NODE_ID=laptop-ana
# MQTT_TOPIC=healer/solutions/v1
# Seconds between tries to send the fixes the broker did not take, while `healer listen` runs
# OUTBOX_RETRY_SECONDS=300
# Using team suggestions in `healer run` (optional; defaults shown)
# TEAM_MAX_DISTANCE=0.1
# TEAM_MAX_SUGGESTIONS=3
# Fixes kept per error from the team; a newer one makes room by dropping the oldest
# TEAM_FIXES_PER_ERROR=5
# MQTT broker. The bundled broker only accepts the nodes added with ./broker.sh.
# start.sh adds this machine and writes its MQTT_USERNAME and MQTT_PASSWORD at the end of this file.
# To use the broker of another machine, copy here the lines that `./broker.sh add NODE_ID` printed
# there; with TLS on, they include MQTT_TLS and MQTT_CA_CERT, and team-ca.crt goes in this folder.
# MQTT_HOST=mosquitto
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=false
# MQTT_CA_CERT=/app/team-ca.crt
# Where the bundled broker listens. 127.0.0.1 keeps a port private to this machine; 0.0.0.0 opens it
# to the network. The plain port should only be opened on a trusted network; on any other, keep it
# private, run `./broker.sh tls ADDRESS` and open the TLS port instead.
# BROKER_BIND=127.0.0.1
# BROKER_PORT=1883
# BROKER_TLS_BIND=127.0.0.1
# BROKER_TLS_PORT=8883
# MQTT_TIMEOUT_SECONDS=10
# MQTT_MAX_RETRIES=2
# The user the containers run as. start.sh writes your own uid and gid here the first time.
# HOST_UID=1000
# HOST_GID=1000
# The local panel (healer panel) opens at http://localhost:8765. It only answers to this computer.
# PANEL_PORT=8765
# How many runs of `healer run` the panel keeps step by step, the newest
# HISTORY_MAX_RUNS=200
