ANTHROPIC_API_KEY=
MQTT_PORT=1883
# Directory of the project to be analyzed/fixed, mounted at /workspace
WORKSPACE_PATH=./workspace
# Test runner (optional; defaults shown)
# TEST_COMMAND=python -m pytest
# ALLOWED_TEST_COMMANDS=["pytest", "python -m pytest"]
# TEST_TIMEOUT_SECONDS=300
# Patch limits (optional; defaults shown)
# MAX_PATCH_FILES=5
# MAX_PATCH_BYTES=100000
# MAX_PATCH_CHANGED_LINES=300
# Claude (optional; defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=high
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_TIMEOUT_SECONDS=120
# ANTHROPIC_MAX_RETRIES=2
# CONTEXT_MAX_CHARS=12000
# CONTEXT_MAX_DISTANCE=0.7
# Self-correction loop (optional; defaults shown)
# REPAIR_MAX_ATTEMPTS=3
# REPAIR_MAX_TOKENS=100000
# Team sharing (Phase 5, optional). Off by default; every node of the team uses the same key.
# Generate a key with: python3 -c "import secrets; print(secrets.token_hex(32))"
# SHARE_SOLUTIONS=false
# SHARE_KEY=
# NODE_ID=laptop-ana
# MQTT_TOPIC=healer/solutions/v1
# Broker credentials and TLS, required outside a trusted local network
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=false
# MQTT_CA_CERT=/path/to/ca.crt
# MQTT_TIMEOUT_SECONDS=10
# MQTT_MAX_RETRIES=2
